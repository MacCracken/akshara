# akshara benchmarks — the tokenizer's hot paths at realistic sizes.
#
# Run as CI does: `CYRIUS_DCE=1 cyrius bench tests/akshara.bcyr`.
# scripts/bench-history.sh runs this file RUNS times and appends the medians to
# bench-history.csv. Every corpus comes from tests/corpora.cyr, so each row
# times the same bytes on every run. Setup (corpus_set, a fresh copy of the
# store) stays outside the timed windows.
include "lib/rosnet.cyr"
include "src/tok.cyr"
include "tests/corpora.cyr"
include "tests/hooks.cyr"

# corpus_set over 1 MiB of pseudo-text at u16: byte vocab + packed store.
fn bench_corpus_set(): i64 {
    var n = 1048576;
    var text = alloc(n);
    cp_text(text, n, 11);
    g_data_w = 2;
    var b = bench_new("corpus_set 1MiB u16");
    var it = 0;
    while (it < 8) {
        bench_start(b);
        corpus_set(text, n);
        bench_stop(b);
        it = it + 1;
    }
    bench_report(b);
    return 0;
}

# bpe_learn(K) over `n` bytes of pseudo-text; a fresh corpus_set per iteration
# (untimed), since learning rewrites the store in place.
fn bench_bpe_learn(name, n, K, iters): i64 {
    var text = alloc(n);
    cp_text(text, n, 23);
    var b = bench_new(name);
    var it = 0;
    while (it < iters) {
        g_data_w = 2;
        corpus_set(text, n);
        bench_start(b);
        bpe_learn(K);
        bench_stop(b);
        it = it + 1;
    }
    bench_report(b);
    return 0;
}

# tok_encode of `plen` bytes through 512 learned merges at output width `ow`.
# The merges come from a 64 KiB corpus; the encoded text is a different
# stretch of the same generator, so it holds unseen pairs as well.
fn bench_encode(name, plen, ow, iters): i64 {
    var n = 65536;
    var text = alloc(n);
    cp_text(text, n, 23);
    g_data_w = 2;
    corpus_set(text, n);
    bpe_learn(BPE_MAX_MERGES());
    var src = alloc(plen);
    cp_text(src, plen, 99);
    var out = alloc(plen * ow);
    var b = bench_new(name);
    var it = 0;
    while (it < iters) {
        bench_start(b);
        tok_encode(src, plen, out, ow);
        bench_stop(b);
        it = it + 1;
    }
    bench_report(b);
    return 0;
}

# A full sequential gd_ld sweep over a 1 MiB u16 store (the training sampler's
# read path, minus the model).
fn bench_gd_ld(): i64 {
    var n = 1048576;
    var text = alloc(n);
    cp_text(text, n, 11);
    g_data_w = 2;
    corpus_set(text, n);
    var b = bench_new("gd_ld sweep 1Mi u16");
    var sink = 0;
    var it = 0;
    while (it < 8) {
        bench_start(b);
        var i = 0;
        while (i < g_datalen) { sink = sink + gd_ld(i); i = i + 1; }
        bench_stop(b);
        it = it + 1;
    }
    bench_report(b);
    if (sink == 0 - 1) { puts("unreachable\n"); }
    return 0;
}

# The same sweep through a streamed shard (a memfd) at the real chunk size: each
# 64 Ki-token chunk is one read plus, since 1.3.1, one vocabulary check. The
# 1.3.0 -> 1.3.1 difference on this row is that check.
fn bench_stream(): i64 {
    var n = 1048576;
    var fd = sys_memfd_create("akshara-bench", 0);
    if (fd < 0) { puts("stream bench: memfd failed\n"); return 0; }
    var img = alloc(n * 2);
    var i = 0;
    while (i < n) { store16(img + i * 2, (i * 37) % 768); i = i + 1; }
    sys_write(fd, img, n * 2);
    var sv_on = g_bpe_on; var sv_b = g_bpe_base; var sv_k = g_bpe_nmerges; var sv_w = g_data_w;
    g_bpe_on = 1; g_bpe_base = 256; g_bpe_nmerges = 512;
    g_stream = 1; g_stream_fd = fd; g_stream_doff = 0;
    g_data_w = 2; g_datalen = n;
    g_stream_cap = STREAM_CHUNK();
    g_stream_buf = alloc(STREAM_CHUNK() * 8);
    var b = bench_new("stream_tok sweep 1Mi u16");
    var sink = 0;
    var it = 0;
    while (it < 8) {
        g_stream_lo = 0 - 1; g_stream_clen = 0;
        bench_start(b);
        i = 0;
        while (i < n) { sink = sink + gd_ld(i); i = i + 1; }
        bench_stop(b);
        it = it + 1;
    }
    bench_report(b);
    g_stream = 0; g_stream_fd = 0 - 1;
    g_bpe_on = sv_on; g_bpe_base = sv_b; g_bpe_nmerges = sv_k; g_data_w = sv_w;
    sys_close(fd);
    if (sink == 0 - 1) { puts("unreachable\n"); }
    return 0;
}

# bpe_build_spans over a learned 512-merge table (checkpoint / shard install).
fn bench_build_spans(): i64 {
    var n = 65536;
    var text = alloc(n);
    cp_text(text, n, 23);
    g_data_w = 2;
    corpus_set(text, n);
    bpe_learn(BPE_MAX_MERGES());
    var b = bench_new("bpe_build_spans 512 merges");
    var it = 0;
    while (it < 200) {
        bench_start(b);
        bpe_build_spans();
        bench_stop(b);
        it = it + 1;
    }
    bench_report(b);
    return 0;
}

# Run every benchmark in a fixed order.
fn main(): i64 {
    alloc_init();
    bench_corpus_set();
    bench_bpe_learn("bpe_learn K=64 64KiB", 65536, 64, 8);
    bench_bpe_learn("bpe_learn K=512 64KiB", 65536, 512, 3);
    bench_bpe_learn("bpe_learn K=512 1MiB", 1048576, 512, 1);
    bench_encode("tok_encode 4KiB prompt i64 (512 merges)", 4096, 8, 20);
    bench_encode("tok_encode 1MiB rebuild u16 (512 merges)", 1048576, 2, 3);
    bench_gd_ld();
    bench_stream();
    bench_build_spans();
    return 0;
}

var r = main();
sys_exit(r);
