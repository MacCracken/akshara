# akshara property checks — invariants of a loaded tokenizer, shared by the
# suite (tests/akshara.tcyr) and the fuzz harness (tests/akshara.fcyr). Include
# after src/tok.cyr. Each returns 1 when the property holds.

# 1 if every merge references only earlier ids and fits BPE_MAX_TOKLEN, and
# every span is its two parents concatenated.
fn _table_ok(): i64 {
    var B = g_bpe_base;
    var m = 0;
    while (m < g_bpe_nmerges) {
        var l = load64(g_merges + (2 * m) * 8);
        var r = load64(g_merges + (2 * m + 1) * 8);
        if ((l < 0) || (r < 0) || (l >= B + m) || (r >= B + m)) { return 0; }
        var ll = load64(g_tok_len + l * 8); var rl = load64(g_tok_len + r * 8);
        var nid = B + m;
        if (load64(g_tok_len + nid * 8) != ll + rl) { return 0; }
        if (ll + rl > BPE_MAX_TOKLEN()) { return 0; }
        var j = 0;
        while (j < ll + rl) {
            var want = 0;
            if (j < ll) { want = load8(g_tok_bytes + l * BPE_MAX_TOKLEN() + j); }
            else { want = load8(g_tok_bytes + r * BPE_MAX_TOKLEN() + j - ll); }
            if (load8(g_tok_bytes + nid * BPE_MAX_TOKLEN() + j) != want) { return 0; }
            j = j + 1;
        }
        m = m + 1;
    }
    var t = 0;
    while (t < B) {
        if (load64(g_tok_len + t * 8) != 1) { return 0; }
        if (load8(g_tok_bytes + t * BPE_MAX_TOKLEN()) != load64(g_vocab + t * 8)) { return 0; }
        t = t + 1;
    }
    return 1;
}

# 1 if expanding every id of the store through its span reproduces g_text.
fn _decodes_to_text(): i64 {
    var pos = 0;
    var i = 0;
    while (i < g_datalen) {
        var id = gd_ld(i);
        var tl = 1;
        if (g_bpe_on == 1) { tl = load64(g_tok_len + id * 8); }
        var j = 0;
        while (j < tl) {
            var b = 0;
            if (g_bpe_on == 1) { b = load8(g_tok_bytes + id * BPE_MAX_TOKLEN() + j); }
            else { b = decode_char(id); }
            if (pos >= g_textlen) { return 0; }
            if (b != load8(g_text + pos)) { return 0; }
            pos = pos + 1; j = j + 1;
        }
        i = i + 1;
    }
    if (pos != g_textlen) { return 0; }
    return 1;
}

# 1 if g_paircnt holds the exact adjacent-pair counts of the final store for
# every pair of live ids (white box: 1.1.2 keeps the counts incrementally).
fn _paircnt_exact(): i64 {
    var V = g_bpe_base + g_bpe_nmerges;
    var cnt = t_alloc(V * V);
    var i = 0;
    while (i + 1 < g_datalen) {
        var c = cnt + (gd_ld(i) * V + gd_ld(i + 1)) * 8;
        store64(c, load64(c) + 1);
        i = i + 1;
    }
    var a = 0;
    while (a < V) {
        var b = 0;
        while (b < V) {
            if (load64(cnt + (a * V + b) * 8) != load64(g_paircnt + (a * BPE_VMAX() + b) * 8)) { return 0; }
            b = b + 1;
        }
        a = a + 1;
    }
    return 1;
}

# 1 if bpe_learn's argmax row cache matches a fresh scan of g_paircnt for every
# live row: the largest count among the cells whose span fits BPE_MAX_TOKLEN, at
# the smallest such column (0 and -1 when no eligible cell is positive). Scans
# right to left with >=, a different route to the same cell. White box: the
# cache is internal (1.2.0) and exact after every learn.
fn _rowcache_exact(): i64 {
    var V = g_bpe_base + g_bpe_nmerges;
    var TL = BPE_MAX_TOKLEN();
    var a = 0;
    while (a < V) {
        var mx = 0; var arg = 0 - 1;
        var b = V - 1;
        while (b >= 0) {
            var c = load64(g_paircnt + (a * BPE_VMAX() + b) * 8);
            if ((c > 0) && (c >= mx) && (load64(g_tok_len + a * 8) + load64(g_tok_len + b * 8) <= TL)) {
                mx = c; arg = b;
            }
            b = b - 1;
        }
        if (load64(_bpe_rmax + a * 8) != mx) { return 0; }
        if (load64(_bpe_rarg + a * 8) != arg) { return 0; }
        a = a + 1;
    }
    return 1;
}

# Snapshot every span: g_tok_len[0, VMAX) then the raw span bytes.
fn _snap_spans(dst): i64 {
    var i = 0;
    while (i < BPE_VMAX()) { store64(dst + i * 8, load64(g_tok_len + i * 8)); i = i + 1; }
    var nb = BPE_VMAX() * BPE_MAX_TOKLEN();
    i = 0;
    while (i < nb) { store8(dst + BPE_VMAX() * 8 + i, load8(g_tok_bytes + i)); i = i + 1; }
    return BPE_VMAX() * 8 + nb;
}

# 1 if bytes a[0, n) == b[0, n).
fn _bytes_eq(a, b, n): i64 {
    var i = 0;
    while (i < n) { if (load8(a + i) != load8(b + i)) { return 0; } i = i + 1; }
    return 1;
}

# 1 if the spans of ids [0, V) equal a _snap_spans snapshot: each id's length,
# and its bytes up to that length. Only the live ids of a table are part of it:
# a rebuild writes tok_len bytes per slot and ids below B + K, so slot tails and
# ids past the table keep whatever an earlier table left there.
fn _spans_eq(snap, V): i64 {
    var t = 0;
    while (t < V) {
        var tl = load64(snap + t * 8);
        if (load64(g_tok_len + t * 8) != tl) { return 0; }
        var j = 0;
        while (j < tl) {
            var live = load8(g_tok_bytes + t * BPE_MAX_TOKLEN() + j);
            if (live != load8(snap + BPE_VMAX() * 8 + t * BPE_MAX_TOKLEN() + j)) { return 0; }
            j = j + 1;
        }
        t = t + 1;
    }
    return 1;
}

# Stream token `at` of the shard on fd (payload at byte doff, n tokens at width
# w, chunk cap `cap`, fresh cache) in a forked child, against the installed
# tokenizer, with the child's stderr captured. Returns 1 when stream_tok failed
# loud with the out-of-vocabulary message, 42 when it returned, 3 when it exited
# 1 with another message, any other exit code as is, or 100 + the signal that
# killed it; -1 / -2 when the memfd / fork failed (1.3.1).
fn _stream_child(fd, doff, w, n, cap, at): i64 {
    var efd = sys_memfd_create("akshara-stderr", 0);
    if (efd < 0) { return 0 - 1; }
    var pid = sys_fork();
    if (pid < 0) { sys_close(efd); return 0 - 2; }
    if (pid == 0) {
        sys_dup2(efd, 2);
        g_stream = 1; g_stream_fd = fd; g_stream_doff = doff;
        g_data_w = w; g_datalen = n;
        g_stream_cap = cap;
        g_stream_buf = alloc(cap * 8);
        g_stream_lo = 0 - 1; g_stream_clen = 0;
        stream_tok(at);
        sys_exit(42);
    }
    var st[8];
    store64(&st, 0);
    sys_waitpid(pid, &st, 0);
    var s = load64(&st) & 65535;
    var code = 100 + (s & 127);
    if ((s & 127) == 0) { code = (s >> 8) & 255; }
    if (code == 1) {
        var want = "akshara: shard token id out of vocabulary -- corrupt shard\n";
        var wl = strlen(want);
        var got[128];
        sys_lseek(efd, 0, 0);
        var nr = sys_read(efd, &got, 127);
        if (nr != wl) { code = 3; }
        var i = 0;
        while ((code == 1) && (i < wl)) {
            if (load8(&got + i) != load8(want + i)) { code = 3; }
            i = i + 1;
        }
    }
    sys_close(efd);
    return code;
}

# Write n ids at width w (from the i64 array ids) to a new memfd after a doff-byte
# header of 0xFF bytes; returns the fd, or -1.
fn _shard_memfd(ids, n, w, doff): i64 {
    var fd = sys_memfd_create("akshara-shard", 0);
    if (fd < 0) { return 0 - 1; }
    var img = alloc(doff + n * 8 + 8);
    var i = 0;
    while (i < doff) { store8(img + i, 255); i = i + 1; }
    i = 0;
    while (i < n) { _tw_st(img + doff, i, w, load64(ids + i * 8)); i = i + 1; }
    if (sys_write(fd, img, doff + n * w) != doff + n * w) { sys_close(fd); return 0 - 1; }
    return fd;
}
