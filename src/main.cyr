# akshara — smoke entry (NOT part of the [lib]; excluded from dist/akshara.cyr).
# Exercises the PURE tokenizer path. The stubs below satisfy the linker for the
# loader/streaming/emit fns whose hooks a real consumer supplies (attn11:
# fileio.cyr / tensor.cyr); the pure smoke never calls them.

include "lib/rosnet.cyr"   # t_alloc / t_zero
include "src/tok.cyr"      # the tokenizer lib (this repo's [lib] module)

# The smoke's own message writer (the library itself no longer needs `puts`).
fn puts(s): i64 { var n = 0; while (load8(s + n) != 0) { n = n + 1; } print(s, n); return 0; }
# tok_emit's byte-level hook: one byte to stdout.
fn _putc(ch): i64 { var b[8]; store8(&b, ch); sys_write(1, &b, 1); return 0; }
# corpus_load_file's hook — unused by the pure smoke: always fails.
fn secure_read_file(path, buf, cap): i64 { return 0 - 1; }
# corpus_load_stdin's hook — unused by the pure smoke: always fails.
fn read_stdin(buf, cap): i64 { return 0 - 1; }
# stream_tok's seek hook — unused by the pure smoke: always fails.
fn file_seek(fd, off): i64 { return 0 - 1; }

# Byte vocab + BPE learn + encode round-trip on a tiny corpus; exit 0 on success.
fn main(): i64 {
    alloc_init();
    # tiny corpus exercising the adaptive byte vocab + BPE + encode round-trip
    var s = "abracadabra";
    var text = alloc(16);
    var i = 0;
    while (load8(s + i) != 0) { store8(text + i, load8(s + i)); i = i + 1; }
    var V = corpus_set(text, i);           # byte vocab + packed store
    if (V < 1) { puts("akshara smoke: FAIL corpus_set\n"); return 1; }
    var Vb = bpe_learn(8);                  # learn up to 8 merges (widens g_data to u16)
    if (Vb < V) { puts("akshara smoke: FAIL bpe_learn\n"); return 1; }
    # re-encoding the original bytes reproduces the stored corpus, bit-for-bit
    var out = alloc(i * 2);
    var n = tok_encode(text, i, out, 2);
    if (n != g_datalen) { puts("akshara smoke: FAIL roundtrip len\n"); return 1; }
    var j = 0;
    while (j < n) {
        if (load16(out + j * 2) != gd_ld(j)) { puts("akshara smoke: FAIL roundtrip ids\n"); return 1; }
        j = j + 1;
    }
    puts("akshara smoke: vocab/BPE/encode OK\n");
    return 0;
}

var r = 0;
r = main();
sys_exit(r);
