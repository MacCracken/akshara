# stream_tok returns whatever id the shard stores, including ids >= the vocabulary
# size. The consumer opens and validates the shard (attn11: src/stream.cyr shard_open,
# which checks the header and tokenizer blob but not the GB-scale token payload), so
# nothing on the read path stops an out-of-vocabulary id reaching the model, where it
# indexes the embedding table. In attn11 <= 1.15.1 that was an out-of-bounds gradient
# WRITE in embed_bwd (fixed downstream in attn11 1.15.2 by a check at every consumer).
#
# Self-proving: the exit code is the number of out-of-vocabulary ids stream_tok handed
# back (2 here). Once stream_tok validates each chunk, the run instead ends in the
# fail-loud akshara message (exit 1 from _ak_fatal), before any bad id is returned.
#
# Filed with docs/development/issues/2026-11-09-stream-tok-unchecked-ids.md.
#
# Build and run from the akshara repo root:
#   cyrius build docs/development/issues/repros/2026-11-09-stream-tok-unchecked-ids.cyr /tmp/aktok
#   /tmp/aktok; echo "exit=$?"      # -> exit=2 on akshara 1.1.3 .. 1.2.0

include "lib/rosnet.cyr"
include "src/tok.cyr"
include "tests/hooks.cyr"

fn main(): i64 {
    alloc_init();
    # a byte-level tokenizer over "hello": V = 4 (h, e, l, o)
    g_data_w = 1;
    var V = corpus_set("hello", 5);
    # a byte-level shard payload (no header needed: g_stream_doff = 0) with two ids >= V
    var N = 7;
    var img = alloc(N);
    store8(img + 0, 0); store8(img + 1, 1); store8(img + 2, 2); store8(img + 3, 3);
    store8(img + 4, 200); store8(img + 5, 3); store8(img + 6, 255);
    var fd = sys_memfd_create("aktok", 0);
    if (fd < 0) { puts("memfd failed\n"); return 99; }
    sys_write(fd, img, N);
    g_stream = 1; g_stream_fd = fd; g_stream_doff = 0;
    g_datalen = N; g_stream_cap = 64;
    g_stream_buf = alloc(g_stream_cap * 2);
    g_stream_lo = 0 - 1; g_stream_clen = 0;
    var oov = 0;
    var i = 0;
    while (i < N) {
        var t = stream_tok(i);
        if ((t < 0) || (t >= V)) {
            puts("stream_tok("); fmt_int(i); puts(") = "); fmt_int(t);
            puts("  >= V = "); fmt_int(V); puts("  (out of vocabulary)\n");
            oov = oov + 1;
        }
        i = i + 1;
    }
    puts("out-of-vocabulary ids returned: "); fmt_int(oov); puts("\n");
    return oov;
}

var _r = main();
syscall(SYS_EXIT, _r);
